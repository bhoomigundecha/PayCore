# Copy to deploy/.env on the server and fill in.

# Your VM's public IP with dots replaced by dashes, plus .sslip.io (free DNS that points at the IP).
# Example for IP 203.0.113.10:
PAYCORE_DOMAIN=203-0-113-10.sslip.io

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Requests per minute per client IP on /accounts and /payments.
PAYCORE_RATE_LIMIT_PER_MINUTE=120

# Card vault keys: three different 32-byte keys. Generate each with: openssl rand -base64 32
# Keep them secret and never change them after cards are issued (old cards could not be decrypted).
PAYCORE_CARD_ENCRYPTION_KEY=
PAYCORE_CARD_FINGERPRINT_KEY=
PAYCORE_CARD_CVC_KEY=

# Key that binds one-time payment codes to the payment (openssl rand -base64 32).
PAYCORE_STEP_UP_CODE_KEY=
